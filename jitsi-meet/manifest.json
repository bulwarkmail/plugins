{
  "id": "jitsi-meet",
  "name": "Jitsi Meet",
  "version": "1.3.1",
  "author": "Bulwark Mail Community",
  "description": "Adds a 'Add Jitsi meeting' button to calendar events. Meeting URLs are generated server-side via the /api/jitsi sidecar.",
  "type": "ui-extension",
  "permissions": [
    "calendar:read",
    "calendar:write",
    "ui:calendar-action",
    "http:post"
  ],
  "entrypoint": "index.js",
  "minAppVersion": "1.15.0",
  "icon": "media/icon.svg",
  "banner": "media/banner.svg",
  "screenshots": [
    "media/screenshots/1-event-form.webp",
    "media/screenshots/2-event-form-dark.webp"
  ],
  "apiPostPaths": [
    "/api/jitsi"
  ]
}
