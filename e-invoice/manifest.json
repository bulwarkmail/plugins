{
  "id": "e-invoice",
  "name": "E-Invoices",
  "version": "1.0.0",
  "author": "Bulwark Mail Community",
  "description": "Shows XRechnung and ZUGFeRD / Factur-X invoices as a readable invoice, checks that their sums add up, prints them, and forwards them to your accounting address in one click. Reads the invoice from the XML attachment or from the XML inside the PDF.",
  "type": "ui-extension",
  "permissions": [
    "email:read",
    "email:blob-read",
    "email:write",
    "email:forward",
    "ui:email-banner",
    "ui:message-list",
    "ui:download-file"
  ],
  "entrypoint": "index.js",
  "minAppVersion": "1.20.0",
  "icon": "media/icon.svg",
  "configSchema": {
    "accountingAddress": {
      "type": "string",
      "label": "Accounting address",
      "description": "Where invoices go when someone clicks \"Forward to accounting\": for example the receipt inbox of DATEV Unternehmen online, lexoffice or sevDesk, or your accountant. Users can set their own unless you use this address for everyone.",
      "placeholder": "rechnungseingang@example.com",
      "default": ""
    },
    "lockAddress": {
      "type": "boolean",
      "label": "Use this address for everyone",
      "description": "Users can't send invoices to an address of their own.",
      "default": false
    }
  },
  "settingsSchema": {
    "accountingAddress": {
      "type": "string",
      "label": "settings.address",
      "description": "settings.address_hint",
      "default": ""
    },
    "forwardWhat": {
      "type": "select",
      "label": "settings.forward_what",
      "description": "settings.forward_what_hint",
      "options": ["forward.all", "forward.invoice_only"],
      "default": "forward.all"
    },
    "autoForward": {
      "type": "boolean",
      "label": "settings.auto_forward",
      "description": "settings.auto_forward_hint",
      "default": false
    },
    "tagMessages": {
      "type": "boolean",
      "label": "settings.tag",
      "description": "settings.tag_hint",
      "default": true
    }
  },
